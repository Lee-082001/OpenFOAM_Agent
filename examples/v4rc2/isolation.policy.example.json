{
  "mode": "strict_linux",
  "cgroup_parent": "/sys/fs/cgroup/USER_DELEGATION/openfoam-agent",
  "writable_volume": "/mnt/ofa-bounded-volume",
  "readonly_runtime_roots": [
    "/opt/openfoam13"
  ],
  "bwrap_path": "/usr/bin/bwrap",
  "limits": {
    "max_native_processes": 120,
    "wall_seconds": 3600,
    "max_processes": 256,
    "memory_bytes": 2147483648,
    "cpu_cores": 4,
    "total_cpu_seconds": 7200,
    "total_wall_seconds": 14400,
    "max_case_bytes": 1073741824,
    "max_output_bytes": 67108864,
    "max_total_output_bytes": 268435456,
    "max_ranks": 4
  }
}
